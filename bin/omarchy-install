#!/usr/bin/env bash
# Dotfiles installer - symlinks everything to ~/.config
# Usage: omarchy-install [--force]

set -euo pipefail

DOTFILES="$HOME/.dotfiles"
FORCE="${1:-}"
BACKUP_DIR="$HOME/.config-backup/$(date +%Y%m%d_%H%M%S)"

link_file() {
    local src="$1"
    local dst="$2"

    if [[ -e "$dst" ]] && [[ ! -L "$dst" ]]; then
        if [[ "$FORCE" != "--force" ]]; then
            echo "  Backing up: $dst"
            mkdir -p "$(dirname "$BACKUP_DIR/${dst#$HOME/}")"
            mv "$dst" "$BACKUP_DIR/${dst#$HOME/}"
        else
            rm -rf "$dst"
        fi
    elif [[ -L "$dst" ]]; then
        rm -f "$dst"
    fi

    mkdir -p "$(dirname "$dst")"
    ln -sf "$src" "$dst"
    echo "  Linked: $dst"
}

link_dir() {
    local src="$1"
    local dst="$2"
    link_file "$src" "$dst"
}

echo "=== Installing Omarchy Dotfiles ==="
echo ""

# Hyprland - symlink individual files (keeps monitors-local.conf local)
echo "[hypr]"
mkdir -p "$HOME/.config/hypr"
for f in "$DOTFILES/config/hypr/"*.conf; do
    link_file "$f" "$HOME/.config/hypr/$(basename "$f")"
done
# Generate monitors-local.conf if missing
if [[ ! -f "$HOME/.config/hypr/monitors-local.conf" ]]; then
    echo "  Generating monitors-local.conf..."
    bash "$DOTFILES/bin/omarchy-monitors-setup" 2>/dev/null || echo "# Fallback" > "$HOME/.config/hypr/monitors-local.conf"
fi

# Config directories to symlink as a whole
echo "[waybar]"
link_dir "$DOTFILES/config/waybar" "$HOME/.config/waybar"
echo "[mako]"
link_dir "$DOTFILES/config/mako" "$HOME/.config/mako"
echo "[rofi]"
link_dir "$DOTFILES/config/rofi" "$HOME/.config/rofi"
echo "[alacritty]"
link_dir "$DOTFILES/config/alacritty" "$HOME/.config/alacritty"
echo "[kitty]"
link_dir "$DOTFILES/config/kitty" "$HOME/.config/kitty"
echo "[tmux]"
link_dir "$DOTFILES/config/tmux" "$HOME/.config/tmux"
echo "[btop]"
link_dir "$DOTFILES/config/btop" "$HOME/.config/btop"
echo "[fastfetch]"
link_dir "$DOTFILES/config/fastfetch" "$HOME/.config/fastfetch"
echo "[nvim]"
link_dir "$DOTFILES/config/nvim" "$HOME/.config/nvim"
echo "[lazygit]"
link_dir "$DOTFILES/config/lazygit" "$HOME/.config/lazygit"
echo "[fontconfig]"
link_dir "$DOTFILES/config/fontconfig" "$HOME/.config/fontconfig"
echo "[ghostty]"
link_dir "$DOTFILES/config/ghostty" "$HOME/.config/ghostty"
echo "[swayosd]"
link_dir "$DOTFILES/config/swayosd" "$HOME/.config/swayosd"
echo "[imv]"
link_dir "$DOTFILES/config/imv" "$HOME/.config/imv"
echo "[walker]"
link_dir "$DOTFILES/config/walker" "$HOME/.config/walker"
echo "[swaync]"
[[ -d "$DOTFILES/config/swaync" ]] && link_dir "$DOTFILES/config/swaync" "$HOME/.config/swaync"
echo "[elephant]"
[[ -d "$DOTFILES/config/elephant" ]] && link_dir "$DOTFILES/config/elephant" "$HOME/.config/elephant"
echo "[uwsm]"
[[ -d "$DOTFILES/config/uwsm" ]] && link_dir "$DOTFILES/config/uwsm" "$HOME/.config/uwsm"
echo "[opencode]"
[[ -d "$DOTFILES/config/opencode" ]] && link_dir "$DOTFILES/config/opencode" "$HOME/.config/opencode"
echo "[wiremix]"
[[ -d "$DOTFILES/config/wiremix" ]] && link_dir "$DOTFILES/config/wiremix" "$HOME/.config/wiremix"
echo "[hyprland-preview-share-picker]"
[[ -d "$DOTFILES/config/hyprland-preview-share-picker" ]] && link_dir "$DOTFILES/config/hyprland-preview-share-picker" "$HOME/.config/hyprland-preview-share-picker"
echo "[omarchy]"
mkdir -p "$HOME/.config/omarchy/hooks"
mkdir -p "$HOME/.config/omarchy/themes"
[[ -f "$DOTFILES/config/omarchy.ttf" ]] && link_file "$DOTFILES/config/omarchy.ttf" "$HOME/.config/omarchy.ttf"

# environment.d
echo "[environment.d]"
link_dir "$DOTFILES/config/environment.d" "$HOME/.config/environment.d"

# systemd user services
echo "[systemd]"
mkdir -p "$HOME/.config/systemd/user"
for f in "$DOTFILES/config/systemd/user/"*; do
    [[ -f "$f" ]] && link_file "$f" "$HOME/.config/systemd/user/$(basename "$f")"
done

# Browser flags
echo "[browser-flags]"
[[ -f "$DOTFILES/config/chromium-flags.conf" ]] && link_file "$DOTFILES/config/chromium-flags.conf" "$HOME/.config/chromium-flags.conf"
[[ -f "$DOTFILES/config/brave-flags.conf" ]] && link_file "$DOTFILES/config/brave-flags.conf" "$HOME/.config/brave-flags.conf"
[[ -f "$DOTFILES/config/xdg-terminals.list" ]] && link_file "$DOTFILES/config/xdg-terminals.list" "$HOME/.config/xdg-terminals.list"

# Applications (.desktop files)
echo "[applications]"
mkdir -p "$HOME/.local/share/applications"
for f in "$DOTFILES/applications/"*.desktop; do
    [[ -f "$f" ]] && link_file "$f" "$HOME/.local/share/applications/$(basename "$f")"
done
if [[ -d "$DOTFILES/applications/hidden" ]]; then
    for f in "$DOTFILES/applications/hidden/"*.desktop; do
        [[ -f "$f" ]] && link_file "$f" "$HOME/.local/share/applications/$(basename "$f")"
    done
fi
if [[ -d "$DOTFILES/applications/icons" ]]; then
    mkdir -p "$HOME/.local/share/icons"
    for f in "$DOTFILES/applications/icons/"*; do
        [[ -f "$f" ]] && link_file "$f" "$HOME/.local/share/icons/$(basename "$f")"
    done
fi

# Starship
echo "[starship]"
link_file "$DOTFILES/config/starship/starship.toml" "$HOME/.config/starship.toml"

# Git
echo "[git]"
mkdir -p "$HOME/.config/git"
link_file "$DOTFILES/config/git/config" "$HOME/.config/git/config"

# Zsh
echo "[zsh]"
link_file "$DOTFILES/config/zsh/zshrc" "$HOME/.zshrc"

# Scripts
echo "[scripts]"
mkdir -p "$HOME/.local/bin"
for script in "$DOTFILES/bin/"*; do
    [[ -f "$script" ]] && link_file "$script" "$HOME/.local/bin/$(basename "$script")"
done

# Theme
echo ""
echo "[theme]"
mkdir -p "$HOME/.config/omarchy/current"
CURRENT_THEME=$(cat "$HOME/.config/omarchy/current/theme.name" 2>/dev/null || cat "$HOME/.config/omarchy/current-theme" 2>/dev/null || echo "tokyo-night")
echo "  Applying theme: $CURRENT_THEME"
OMARCHY_PATH="$DOTFILES" omarchy-theme-set "$CURRENT_THEME" 2>/dev/null || true

# GTK
gsettings set org.gnome.desktop.interface gtk-theme "Adwaita-dark" 2>/dev/null || true
gsettings set org.gnome.desktop.interface color-scheme "prefer-dark" 2>/dev/null || true

# Docker group check
if command -v docker &>/dev/null && ! groups | grep -q docker; then
    echo ""
    echo "[docker]"
    echo "  Run: sudo usermod -aG docker $USER"
fi

echo ""
echo "=== Done! ==="
echo ""
echo "Next steps:"
echo "  1. Change shell:    chsh -s /bin/zsh"
echo "  2. Reload Hyprland: hyprctl reload"
echo "  3. Switch themes:   omarchy-theme-set [theme-name]"
echo "  4. Log out and back in for shell change to take effect"
