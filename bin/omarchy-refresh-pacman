#!/bin/bash

# Restore pacman.conf from dotfiles default (CachyOS optimized)
# Unlike Omarchy, CachyOS manages its own mirrors, so we only restore the main config.

OMARCHY_PATH=${OMARCHY_PATH:-$HOME/.dotfiles}

echo -e "\e[32mRestoring pacman.conf from dotfiles default\e[0m"

sudo cp -f /etc/pacman.conf "/etc/pacman.conf.bak.$(date +%s)"
sudo cp -f "$OMARCHY_PATH/default/pacman/pacman.conf" /etc/pacman.conf

echo -e "\e[32mDone. Previous config backed up.\e[0m"
echo "Run 'sudo pacman -Syyu' to refresh package databases."
