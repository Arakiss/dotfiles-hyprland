#!/usr/bin/env bash
# Screenshot utility using grim + slurp + satty
# Usage: omarchy-screenshot [full|area|window]

SCREENSHOTS_DIR="$HOME/Imágenes/Screenshots"
mkdir -p "$SCREENSHOTS_DIR"

timestamp=$(date +%Y%m%d_%H%M%S)
filename="$SCREENSHOTS_DIR/screenshot_$timestamp.png"

case "${1:-area}" in
    full)
        grim "$filename"
        ;;
    area)
        grim -g "$(slurp)" "$filename"
        ;;
    window)
        grim -g "$(hyprctl activewindow -j | jq -r '"\(.at[0]),\(.at[1]) \(.size[0])x\(.size[1])"')" "$filename"
        ;;
esac

if [[ -f "$filename" ]]; then
    wl-copy < "$filename"

    # Open in satty if available, otherwise just notify
    if command -v satty &>/dev/null; then
        satty --filename "$filename" --output-filename "$filename"
    else
        notify-send "Screenshot" "Saved to $filename" -i "$filename" -t 3000
    fi
fi
