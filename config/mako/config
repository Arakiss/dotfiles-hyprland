# Mako notification daemon
# Auto-generated by omarchy-theme-set — manual edits will be overwritten

# ── Layout ────────────────────────────────────
max-visible=4
sort=-time
layer=overlay
anchor=top-right

# ── Typography ────────────────────────────────
font=JetBrainsMono Nerd Font 10

# ── Appearance ────────────────────────────────
background-color=#1a1b26dd
text-color=#c0caf5
border-color=#7aa2f7
border-size=2
border-radius=12
padding=16,20
margin=12
width=380
height=180
default-timeout=5000
ignore-timeout=0

# ── Icons ─────────────────────────────────────
icons=1
max-icon-size=56
icon-location=left

# ── Grouping ──────────────────────────────────
group-by=app-name
format=<b>%s</b>\n%b

# ── Actions ───────────────────────────────────
on-button-left=invoke-default-action
on-button-middle=none
on-button-right=dismiss

# ── Urgency: Low ──────────────────────────────
[urgency=low]
border-color=#565f89
text-color=#a9b1d6
background-color=#1a1b26bb
default-timeout=3000

# ── Urgency: Normal ──────────────────────────
[urgency=normal]
border-color=#7aa2f7

# ── Urgency: High ────────────────────────────
[urgency=high]
border-color=#e0af68
background-color=#1a1b26ee
default-timeout=10000

# ── Urgency: Critical ────────────────────────
[urgency=critical]
border-color=#f7768e
background-color=#1a1b26ff
text-color=#f7768e
default-timeout=0

# ── App Overrides ─────────────────────────────
[app-name=Spotify]
border-color=#9ece6a
default-timeout=3000

[app-name=discord]
border-color=#bb9af7
default-timeout=4000

[app-name=firefox]
border-color=#ff9e64

[app-name="Brave Browser"]
border-color=#ff9e64

[app-name=thunderbird]
border-color=#7dcfff

[app-name=Steam]
border-color=#9ece6a

[app-name=NetworkManager]
border-color=#7dcfff
default-timeout=4000

[app-name=bluetoothctl]
border-color=#7dcfff
default-timeout=3000

# ── Grouped ──────────────────────────────────
[grouped=true]
format=(%g) <b>%s</b>\n%b
