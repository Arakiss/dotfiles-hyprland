# Mako notification daemon - Tokyo Night theme

max-visible=5
sort=-time
layer=overlay
anchor=top-right

font=JetBrainsMono Nerd Font 10
background-color=#1a1b26ee
text-color=#a9b1d6
border-color=#7aa2f7
border-size=2
border-radius=10
padding=12
margin=10
width=350
height=150
default-timeout=5000
ignore-timeout=0
icons=1
max-icon-size=48
icon-location=left

[urgency=low]
border-color=#565f89
default-timeout=3000

[urgency=high]
border-color=#f7768e
default-timeout=10000

[urgency=critical]
border-color=#f7768e
default-timeout=0
