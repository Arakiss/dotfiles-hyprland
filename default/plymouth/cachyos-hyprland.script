# CachyOS Hyprland Plymouth Theme
# Tokyo Night color scheme boot splash

# Background: Tokyo Night Storm
Window.SetBackgroundTopColor(0.102, 0.106, 0.149);
Window.SetBackgroundBottomColor(0.086, 0.086, 0.118);

# Reuse CachyOS boot animation frames if available, otherwise show text
logo_exists = 0;

# Try CachyOS logo first, fallback to text
fun try_load_logo() {
    global.logo_image = Image("logo.png");
    if (global.logo_image) {
        global.logo_sprite = Sprite(global.logo_image);
        global.logo_sprite.SetX(Window.GetWidth() / 2 - global.logo_image.GetWidth() / 2);
        global.logo_sprite.SetY(Window.GetHeight() / 2 - global.logo_image.GetHeight() / 2 - 40);
        global.logo_sprite.SetOpacity(1);
        global.logo_exists = 1;
    }
}

try_load_logo();

# If no logo, show text branding
if (global.logo_exists == 0) {
    branding = Image.Text("CachyOS", 0.478, 0.635, 0.969, 1, "JetBrainsMono Nerd Font");
    branding_sprite = Sprite(branding);
    branding_sprite.SetX(Window.GetWidth() / 2 - branding.GetWidth() / 2);
    branding_sprite.SetY(Window.GetHeight() / 2 - branding.GetHeight() / 2 - 40);
}

# Progress bar config
global.progress_max_width = 200;
global.progress_height = 3;
global.max_progress = 0.0;

# Progress bar background (dark track)
progress_bg = Image("progress_box.png");
if (!progress_bg) {
    # Fallback: create a simple colored rectangle via text trick
    progress_bg = Image.Text("", 0.337, 0.373, 0.537);
}

# Progress indicator using accent color (#7aa2f7)
progress_x = Window.GetWidth() / 2 - global.progress_max_width / 2;
progress_y = Window.GetHeight() / 2 + 30;

# Simple progress animation
global.fake_progress = 0.0;
global.fake_progress_active = 0;
global.frame = 0;

fun refresh_callback() {
    global.frame++;

    if (global.fake_progress_active == 1) {
        t = global.frame / 50.0;
        ratio = t / 12.0;
        if (ratio > 1.0)
            ratio = 1.0;

        # Ease-out quadratic
        eased = 1 - ((1 - ratio) * (1 - ratio));
        global.fake_progress = eased * 0.75;
        update_progress(global.fake_progress);
    }
}

Plymouth.SetRefreshFunction(refresh_callback);

# Progress bar rendering with text-based colored blocks
global.bar_sprite = Sprite();
global.bar_sprite.SetPosition(progress_x, progress_y, 2);

fun update_progress(progress) {
    if (progress > global.max_progress) {
        global.max_progress = progress;
        width = Math.Int(global.progress_max_width * progress);
        if (width < 1) width = 1;

        # Tokyo Night blue accent bar
        bar_text = "";
        for (i = 0; i < width / 4; i++)
            bar_text += "█";

        bar_image = Image.Text(bar_text, 0.478, 0.635, 0.969);
        global.bar_sprite.SetImage(bar_image);
    }
}

# Boot progress
fun progress_callback(duration, progress) {
    global.real_progress = progress;
    if (progress > 0.75) {
        global.fake_progress_active = 0;
        update_progress(progress);
    }
}

Plymouth.SetBootProgressFunction(progress_callback);

# Normal display (no password needed)
fun display_normal_callback() {
    global.fake_progress_active = 1;
    global.frame = 0;
}

Plymouth.SetDisplayNormalFunction(display_normal_callback);

# Password dialog for LUKS
fun display_password_callback(prompt, bullets) {
    global.fake_progress_active = 0;

    # Lock icon
    lock_text = Image.Text("  " + prompt, 0.337, 0.373, 0.537);
    global.lock_sprite = Sprite(lock_text);
    global.lock_sprite.SetX(Window.GetWidth() / 2 - lock_text.GetWidth() / 2);
    global.lock_sprite.SetY(progress_y + 20);

    # Bullets
    bullet_str = "";
    for (i = 0; i < bullets; i++)
        bullet_str += "● ";

    if (bullet_str != "") {
        bullet_image = Image.Text(bullet_str, 0.753, 0.792, 0.957);
        global.bullet_sprite = Sprite(bullet_image);
        global.bullet_sprite.SetX(Window.GetWidth() / 2 - bullet_image.GetWidth() / 2);
        global.bullet_sprite.SetY(progress_y + 45);
    }
}

Plymouth.SetDisplayPasswordFunction(display_password_callback);

# Quit
fun quit_callback() {
    # Fade is handled by Plymouth itself
}

Plymouth.SetQuitFunction(quit_callback);

# Messages
message_sprite = Sprite();
message_sprite.SetPosition(10, 10, 10000);

fun display_message_callback(text) {
    msg = Image.Text(text, 0.663, 0.694, 0.812);
    message_sprite.SetImage(msg);
}

fun hide_message_callback(text) {
    message_sprite.SetOpacity(0);
}

Plymouth.SetDisplayMessageFunction(display_message_callback);
Plymouth.SetHideMessageFunction(hide_message_callback);
